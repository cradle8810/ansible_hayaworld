services:
  dnsmasq:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: dnsmasq
    ports:
      - "53:53/udp"
      - "53:53/tcp"
    cap_add:
      - NET_RAW
      - NET_ADMIN
    restart: always
    volumes:
      - ./dnsmasq.conf:/etc/dnsmasq.conf
      - ./hayaworld_hosts:/etc/hayaworld_hosts
    healthcheck:
      test: ["CMD", "nslookup", "-port=53", "google.co.jp", "127.0.0.1"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 5s
    labels:
      - "autoheal=true"

  autoheal:
    image: willfarrell/autoheal:latest
    tty: true
    container_name: autoheal_dnsmasq
    restart: always
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
networks:
  default:
    enable_ipv6: true
